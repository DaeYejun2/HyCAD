[Unit]
Description=HyCAD public HTTPS gateway
Wants=network-online.target
Requires=snap.docker.dockerd.service hycad-monitor.service
After=network-online.target snap.docker.dockerd.service hycad-monitor.service
PartOf=snap.docker.dockerd.service
RequiresMountsFor=/var/snap/docker/common/hycad/current /var/snap/docker/common/hycad/https
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/snap/docker/common/hycad/current
EnvironmentFile=/etc/hycad/ingress.env
ExecStartPre=/usr/bin/test ${DOCKER_HOST} = unix:///var/snap/docker/common/hycad/docker.sock
ExecStartPre=/usr/bin/test -S /var/snap/docker/common/hycad/docker.sock
ExecStart=/usr/bin/docker --host ${DOCKER_HOST} compose --env-file /etc/hycad/ingress.env -f compose.ingress.yaml up --detach --no-build
ExecStop=/usr/bin/docker --host ${DOCKER_HOST} compose --env-file /etc/hycad/ingress.env -f compose.ingress.yaml stop --timeout 30
Restart=on-failure
RestartSec=15s
TimeoutStartSec=120s
TimeoutStopSec=60s
UMask=0077

[Install]
WantedBy=multi-user.target
