[Unit]
Description=HyCAD bounded incident evidence preservation
Wants=network-online.target hycad-monitor.service hycad-collector.service
After=network-online.target hycad-monitor.service
RequiresMountsFor=/opt/hycad/current /var/lib/hycad/live /var/lib/hycad/evidence
StartLimitIntervalSec=0

[Service]
Type=exec
User=hycad
Group=hycad-data
WorkingDirectory=/opt/hycad/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TARGET_PORT=22
EnvironmentFile=/etc/hycad/monitor.env
UnsetEnvironment=GRAFANA_ADMIN_PASSWORD
ExecStart=/usr/bin/python3 /opt/hycad/current/scripts/preserve_incidents.py --host ${TARGET_HOST} --port ${TARGET_PORT} --identity /etc/hycad/context_ed25519 --known-hosts /etc/hycad/known_hosts --events /var/lib/hycad/live/events.jsonl --root /var/lib/hycad/evidence
Restart=always
RestartSec=5s
TimeoutStopSec=120s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/hycad/evidence /var/lib/hycad/live
ReadOnlyPaths=/opt/hycad/current /etc/hycad/context_ed25519 /etc/hycad/known_hosts
InaccessiblePaths=/etc/hycad/monitor.env
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
TasksMax=32

[Install]
WantedBy=multi-user.target
