# Copy outside Git to /etc/hycad/ingress.env, mode 0600; fill verified values.
DOCKER_HOST=unix:///var/snap/docker/common/hycad/docker.sock
HYCAD_HTTPS_DIR=/var/snap/docker/common/hycad/https
HYCAD_INGRESS_BIND_IP=REPLACE_WITH_SERVER_LAN_IP
HYCAD_MONITOR_NETWORK=hycad-monitor_default
HYCAD_NGINX_IMAGE=nginx@sha256:REPLACE_WITH_VERIFIED_DIGEST
HYCAD_CERTBOT_IMAGE=certbot/certbot@sha256:REPLACE_WITH_VERIFIED_DIGEST
HYCAD_CERT_NAME=hycad-public
