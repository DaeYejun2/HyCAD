    {
      "id": 6,
      "title": "입력 원본 구간 종료",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hycad-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "캡처 모드에서는 과거 캡처의 시각입니다. LIVE 입력 상태와 혼동하지 않습니다.",
