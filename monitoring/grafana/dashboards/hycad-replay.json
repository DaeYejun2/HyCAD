    {
      "id": 4,
      "title": "시스템콜 빈도 탐지기 초과 레플리카",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hycad-prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "description": "현재 창에서 자신의 시스템콜 빈도 탐지기 점수가 기준선 임계값을 넘은 레플리카 수입니다. 전체 이상 의심이 곧 4개 모두 초과했다는 뜻은 아닙니다.",
      "fieldConfig": {
        "defaults": {
          "noValue": "판정 불가 입력 확인",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "판정 불가",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hycad-prometheus"
          },
          "editorMode": "code",
          "expr": "sum((hycad_channel_b_score{job=\"hycad-manual\",deployment=\"$deployment\",mode=\"$mode\",capture=\"$capture\"} > bool on(deployment,mode,capture,job,instance) group_left() hycad_threshold{job=\"hycad-manual\",deployment=\"$deployment\",mode=\"$mode\",capture=\"$capture\",channel=\"b\"}) and on(deployment,mode,capture,job,instance) ((hycad_ready{job=\"hycad-manual\",deployment=\"$deployment\",mode=\"$mode\",capture=\"$capture\"} and on(job,instance) (up{job=\"hycad-manual\"} == 1)) == 1)) or vector(-1)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": ""
        }
      ]
    },
    {
