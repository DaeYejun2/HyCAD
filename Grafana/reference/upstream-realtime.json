  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "판정",
      "description": "A 지목 있음 → 부분 감염 / A 침묵·B 정상 → 정상 / A 침묵·B 이상·C 변동 → 전원 감염 / C 안정 → 정상 변화",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hycad_verdict_code{job=\"hycad-realtime\"}",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "판정"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "정상 변화",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "부분 감염",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "전원 감염",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
