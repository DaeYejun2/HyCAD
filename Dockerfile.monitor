FROM python:3.14-slim
WORKDIR /app
COPY requirements-monitor.txt .
RUN pip install --no-cache-dir -r requirements-monitor.txt && useradd --uid 10001 --create-home hycad && test -x /usr/bin/setpriv && mkdir /state && chown 10001:10001 /state
COPY channels.py controller.py preprocess.py ./
COPY hycad_monitor ./hycad_monitor
COPY cache ./cache
USER 10001
EXPOSE 9108
ENTRYPOINT ["/usr/bin/setpriv", "--no-new-privs", "python", "-m", "hycad_monitor"]
